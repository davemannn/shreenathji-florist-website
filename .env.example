# Database (local Docker MariaDB; swap to Hostinger connection string in production)
DATABASE_URL="mysql://florist:florist@localhost:3306/shreenathji_florist"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Separate secret for the Subscriptions webhook (Dashboard > Webhooks >
# create one pointed at /api/webhooks/razorpay, subscribed to at least
# subscription.activated/charged/cancelled/completed/halted) — NOT the same
# value as RAZORPAY_KEY_SECRET above. Only required once subscriptions are
# actually enabled; recurring billing can't work without it since charges
# happen server-to-server with no user request to verify against.
RAZORPAY_WEBHOOK_SECRET=""

# Email (Hostinger business mailbox, sent via SMTP — see hPanel > Emails >
# Configuration for the exact host/port if it differs from these defaults;
# SMTP_PASS is the mailbox's own password, or an app-specific password if
# 2FA is enabled on it)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="support@shrinathjiflorist.com"
SMTP_PASS=""
EMAIL_FROM="Shreenathji Florist <support@shrinathjiflorist.com>"

# Reminder emails (birthday/anniversary) now send themselves — an
# in-process node-cron schedule started from src/instrumentation.ts fires
# daily at 8am IST as long as the server process stays running (see
# package.json's "start" script). This secret only gates the
# /api/cron/send-reminders route, kept around as a manual "run it now"
# fallback (Authorization: Bearer <CRON_SECRET>) — not required for the
# daily send to work.
CRON_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Sign-In (customer-facing "Continue with Google" — see
# server/auth/config.ts's socialProviders.google). Create an OAuth 2.0
# Client ID in Google Cloud Console > APIs & Services > Credentials
# (Application type: Web application), with an authorized redirect URI of
# `${BETTER_AUTH_URL}/api/auth/callback/google` (e.g.
# http://localhost:3000/api/auth/callback/google in dev, your real domain
# in production — add both if you test both). Sign-in stays email/password-
# only while these are blank; the button just doesn't render.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
# Cloud name and API key aren't secret (the client-side signed-upload widget
# sends both as part of the request it makes to Cloudinary) — only the API
# secret above must stay server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# Google Maps (Places Autocomplete for address input — checkout, account
# addresses, and the admin store-location picker in /admin/settings; see
# lib/google-maps.ts). Create a key in Google Cloud Console > APIs &
# Services > Credentials, enable "Places API" and "Maps JavaScript API" on
# it, and restrict it to this site's HTTP referrers (your domain +
# localhost while developing). Public by necessity (loaded client-side,
# same as the Cloudinary keys above) — the referrer restriction is what
# actually secures it, not secrecy. Every address-search box just quietly
# disappears (falls back to plain manual entry) while this is blank; the
# delivery-radius check in /admin/settings also stays off until it's set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
