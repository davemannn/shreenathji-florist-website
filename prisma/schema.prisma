// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Auth models — required by Better Auth (src/server/auth/config.ts).
// Field shapes match Better Auth's own documented schema exactly (verified
// against node_modules/@better-auth/core/dist/db/schema/*.d.mts), plus the
// role/banned/banReason/banExpires/impersonatedBy fields added by its admin
// plugin.
// ---------------------------------------------------------------------------

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  emailVerified         Boolean                @default(false)
  image                 String?
  role                  String?
  banned                Boolean?               @default(false)
  banReason             String?
  banExpires            DateTime?
  // Staff contact info (delivery_guy in particular — a store manager may
  // need to call them). Nullable, harmless for regular customers too.
  phone                 String?
  // Store credit — credited by redeeming a GiftCard (see GiftCard.redeemedAt
  // below) and spent at checkout (Order.walletAmountUsed). Debited/credited
  // via user.repository.ts's adjustUserWalletBalance, always inside the
  // same transaction as whatever order/redemption caused the change.
  walletBalance         Int                    @default(0)
  // Opt-out for the admin bulk/marketing sender's segment-targeted sends
  // (features/marketing-email) — separate from NewsletterSubscriber, since
  // being a customer implies a different (narrower, existing-relationship)
  // consent basis than explicitly opting into the newsletter. Order/OTP/
  // account emails are unaffected by this — it only gates marketing sends.
  marketingOptOut       Boolean                @default(false)
  /// Staff-only personalization: this admin's own drag-reordered admin
  /// sidebar item order, as an array of `AdminNavItem.href` strings (see
  /// config/admin-navigation.ts). Null = use the config's default order.
  /// Purely cosmetic — never affects which items a role can see, only the
  /// order they're listed in for this one person. Harmless/unused for
  /// regular customers.
  adminNavOrder         Json?
  /// Generated lazily (see referral.repository.ts's getOrCreateReferralCode)
  /// the first time this user opens /account/referral, not at signup —
  /// most users never need one. Shared as `/sign-up?ref=<code>`.
  referralCode          String?                @unique
  /// Set at most once, within a short freshness window right after this
  /// user's own signup (see features/referral/actions.ts) — never
  /// retroactively reassignable, closing off the obvious "claim someone
  /// else's existing account as your referral" abuse path.
  referredByUserId      String?
  /// Flips true the first time referredBy's reward is actually granted
  /// (this user's first CONFIRMED/PAID order) — guards against
  /// double-crediting if that hook ever fires twice for the same order.
  referralRewardGranted Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  accounts              Account[]
  addresses             Address[]
  orders                Order[]
  giftCards             GiftCard[]
  // Gift cards THIS user redeemed to their own wallet — distinct from
  // `giftCards` above (cards they purchased, which may have been redeemed
  // by someone else entirely if bought as a gift).
  giftCardRedemptions   GiftCard[]             @relation("GiftCardRedemptions")
  // Orders assigned to this user when they're staff with the delivery_guy role.
  deliveryAssignments   Order[]                @relation("DeliveryAssignments")
  giftCardAdjustments   GiftCardAdjustment[]
  orderRefundsProcessed OrderRefund[]
  subscriptions         CustomerSubscription[]
  reminders             Reminder[]
  cartSnapshot          CartSnapshot?
  tags                  CustomerTag[]
  referredBy            User?                  @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals             User[]                 @relation("Referrals")
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Commerce models — shop catalog, cart-to-order flow, checkout. Money is
// stored as Int whole rupees throughout (matches the fixture data this
// replaces); converted to paise only at the Razorpay API boundary.
// ---------------------------------------------------------------------------

enum ProductBadge {
  SALE
  NEW
  BESTSELLER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  RAZORPAY
  /// The order's full total was covered by the customer's wallet balance —
  /// no cash to collect and no gateway payment exists, so this must stay
  /// visually distinct from COD/RAZORPAY everywhere it's displayed (order
  /// tables, invoices, delivery staff views) to avoid delivery staff
  /// expecting to collect cash that isn't due. See order.service.ts's
  /// placeOrder — assigned automatically, never chosen by the customer.
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  /// Cumulative Razorpay refunds (Order.refundedAmount) reached the full
  /// charged amount (total - walletAmountUsed) — see order.repository.ts's
  /// recordOrderRefund.
  REFUNDED
  /// Some, but not all, of the charged amount has been refunded so far —
  /// more can still be refunded up to the charged amount.
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum DeliverySlotType {
  NORMAL
  FIXED
  MIDNIGHT
}

model Category {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  imageUrl          String?
  // Set only for admin-uploaded Cloudinary images (Phase 3+) — the seeded
  // Pexels stock photos have no Cloudinary asset to clean up, so this stays
  // null for those. Lets the admin action call cloudinary.uploader.destroy()
  // on replace/remove instead of leaving orphaned assets.
  imageCloudinaryId String?
  isOccasion        Boolean           @default(false)
  /// A second, independent nav axis alongside isOccasion — "For Her",
  /// "For Him", "For Parents", etc. A category could in principle be both
  /// (unusual but not prevented); the nav groups it into whichever
  /// section(s) apply. See features/category/queries.ts's
  /// getNavCategoryGroups.
  isRecipient       Boolean           @default(false)
  isFeatured        Boolean           @default(false)
  /// Hides this category from the storefront (nav + shop pages) without
  /// deleting it — unlike hard delete, doesn't require reassigning its
  /// products first. Hard delete (category.repository.ts's deleteCategory)
  /// still exists for genuinely-unused categories.
  isArchived        Boolean           @default(false)
  sortOrder         Int               @default(0)
  /// GST% for products in this category (e.g. 0 for fresh flowers, 18 for
  /// chocolates) — null means "not set yet", falls back to
  /// StoreSettings.defaultGstRate. Only meaningful on Shop categories
  /// (isOccasion: false) — see lib/tax.ts's resolveProductTax, which skips
  /// Occasion categories (Birthday, Anniversary, ...) since they're a
  /// cross-cutting tag, not a product type.
  gstRate           Int?
  /// HSN (goods) / SAC (services) code for GST invoices — same isOccasion
  /// caveat as gstRate above.
  hsnCode           String?
  products          ProductCategory[]
}

model Product {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  description  String            @db.Text
  badge        ProductBadge?
  isActive     Boolean           @default(true)
  isBestSeller Boolean           @default(false)
  isFeatured   Boolean           @default(false)
  /// Free-text "what's included" line for a combo/hamper product (e.g. "12
  /// Red Roses + 500g Chocolate Truffle Cake + Teddy Bear"), shown as a
  /// callout on the product card/detail page when set. Deliberately not a
  /// relational bundle-of-products model — a combo is still sold and
  /// priced as one ordinary Product/Variant, this is purely the
  /// customer-facing description of what's inside. Pair with a "Combos"
  /// Category (an ordinary Category row, isOccasion/isRecipient both
  /// false) for it to show up as its own shop section.
  comboIncludes String?          @db.Text
  rating       Float             @default(0)
  reviewCount  Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  categories   ProductCategory[]
  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  orderItems   OrderItem[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  url          String
  alt          String
  sortOrder    Int     @default(0)
  cloudinaryId String?
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  label             String
  price             Int
  compareAtPrice    Int?
  stock             Int         @default(0)
  isDefault         Boolean     @default(false)
  sortOrder         Int         @default(0)
  /// Optional — lets a variant (e.g. "Red roses" vs "White roses") show its
  /// own photo instead of the product's default image, so switching
  /// variants on the storefront actually shows what the customer is buying.
  /// Falls back to the product's own images when unset.
  imageUrl          String?
  imageCloudinaryId String?
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]

  @@index([productId])
}

model Address {
  id             String   @id @default(cuid())
  userId         String
  label          String?
  recipientName  String
  recipientPhone String
  line1          String
  line2          String?
  city           String
  state          String
  pincode        String
  /// Set when this address was picked via the Google Places autocomplete
  /// (see lib/google-maps.ts) — null for addresses typed by hand before
  /// that existed, or if the picker's geocode lookup failed. Used only to
  /// check delivery-radius serviceability at checkout; never required.
  latitude       Float?
  longitude      Float?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeliverySlot {
  id          String           @id @default(cuid())
  label       String
  type        DeliverySlotType @default(NORMAL)
  extraCharge Int              @default(0)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  orders      Order[]
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Int
  minOrderValue Int?
  maxDiscount   Int?
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  usageLimit    Int?
  usedCount     Int          @default(0)
  orders        Order[]
}

model Order {
  id                       String        @id @default(cuid())
  orderNumber              String        @unique
  userId                   String
  status                   OrderStatus   @default(PENDING)
  subtotal                 Int
  discount                 Int           @default(0)
  deliveryCharge           Int           @default(0)
  total                    Int
  /// Portion of `total` paid from the customer's wallet balance (0 if none
  /// used). `total` itself is unchanged by this — same pattern as
  /// `discount` — so what's still owed via COD/Razorpay is `total -
  /// walletAmountUsed`. Restored to the customer's wallet if the order is
  /// later cancelled — see order.repository.ts's updateOrderStatus.
  walletAmountUsed         Int           @default(0)
  paymentMethod            PaymentMethod
  paymentStatus            PaymentStatus @default(PENDING)
  razorpayOrderId          String?
  razorpayPaymentId        String?
  /// Cumulative ₹ refunded via Razorpay so far (0 if none) — capped at
  /// `total - walletAmountUsed`, the actual gateway-charged amount. Kept in
  /// sync with the sum of this order's OrderRefund rows inside the same
  /// transaction — see order.repository.ts's recordOrderRefund.
  refundedAmount           Int           @default(0)
  // --- Razorpay transaction details — fetched once via payments.fetch()
  // right after payment verification (checkout/actions.ts), not from the
  // client-side callback (which only ever hands back IDs + a signature).
  // All null for COD/WALLET orders, or if the fetch itself failed (kept
  // best-effort — the order is already legitimately paid by then, a
  // failed detail lookup shouldn't undo that).
  razorpayMethod           String?
  razorpayContact          String?
  razorpayEmail            String?
  razorpayVpa              String?
  razorpayBank             String?
  razorpayWallet           String?
  razorpayCardLast4        String?
  razorpayCardNetwork      String?
  recipientName            String
  recipientPhone           String
  deliveryLine1            String
  deliveryLine2            String?
  deliveryCity             String
  deliveryState            String
  deliveryPincode          String
  /// Snapshotted from the Address (or the checkout map picker) at order
  /// time, same "never rewritten later" convention as the rest of this
  /// delivery block — null for orders placed before this existed or whose
  /// address had no geocode. Not used for anything at read time today;
  /// kept for a possible future delivery-route/map view.
  deliveryLatitude         Float?
  deliveryLongitude        Float?
  deliveryDate             DateTime
  deliverySlotId           String?
  messageCard              String?
  giftWrap                 Boolean       @default(false)
  couponId                 String?
  /// Set only when this order was auto-created by a recurring subscription
  /// charge (see the Razorpay webhook handler) — same admin pipeline as any
  /// other order otherwise (delivery-slot assignment, status tracking,
  /// invoicing all work identically), this field just traces it back.
  subscriptionId           String?
  // Admin panel — order management (Phase 2).
  assignedDeliveryPersonId String?
  deliveredAt              DateTime?

  // --- Tax (GST) — snapshotted at order-confirmation time so a rate or
  // GSTIN change later never rewrites an already-issued invoice's numbers.
  // `total` above is unchanged by any of this — it's still what the
  // customer paid; these fields just document its tax-inclusive breakup.
  /// Seller's GSTIN as of this order — null if not GST-registered (or not
  /// yet configured) when the order was placed; the invoice then omits the
  /// GST block rather than show stale/blank tax data.
  sellerGstin   String?
  sellerState   String?
  /// deliveryState != sellerState → IGST; same state → CGST+SGST split.
  isInterState  Boolean   @default(false)
  taxableValue  Int       @default(0)
  cgstAmount    Int       @default(0)
  sgstAmount    Int       @default(0)
  igstAmount    Int       @default(0)
  totalTax      Int       @default(0)
  /// Assigned once, at order confirmation (COD accept / payment verified) —
  /// not at cart-checkout time — so a payment that never completes doesn't
  /// burn a sequential invoice number. Format: "{prefix}/{FY}/{sequence}".
  invoiceNumber String?   @unique
  invoicedAt    DateTime?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User                  @relation(fields: [userId], references: [id])
  deliverySlot           DeliverySlot?         @relation(fields: [deliverySlotId], references: [id])
  coupon                 Coupon?               @relation(fields: [couponId], references: [id])
  assignedDeliveryPerson User?                 @relation("DeliveryAssignments", fields: [assignedDeliveryPersonId], references: [id])
  subscription           CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  refunds                OrderRefund[]

  @@index([userId])
  @@index([assignedDeliveryPersonId])
  @@index([subscriptionId])
}

/// Audit trail for Razorpay refunds — one row per refund call, so multiple
/// partial refunds on the same order (and who processed each, and why) are
/// all individually visible. Order.refundedAmount is the running total kept
/// in sync with the sum of these rows.
model OrderRefund {
  id                String   @id @default(cuid())
  orderId           String
  /// ₹ refunded in this transaction (not cumulative — see Order.refundedAmount for that).
  amount            Int
  razorpayRefundId  String
  /// Razorpay's own refund status at the time this was recorded: 'pending' | 'processed' | 'failed'.
  razorpayStatus    String
  /// @db.Text — the form allows up to 300 chars (processRefundSchema), well
  /// past the default VARCHAR(191) this would otherwise get.
  reason            String?  @db.Text
  processedByUserId String
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedBy       User     @relation(fields: [processedByUserId], references: [id])

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Recurring flower subscriptions (daily pooja flowers, weekly bouquet boxes,
// raw flower deliveries...). Razorpay's Subscriptions API (Plans →
// Subscriptions, distinct from the one-time Orders/Payments API already
// used for normal checkout) — see server/payments/razorpay.ts and the
// webhook handler at app/api/webhooks/razorpay/route.ts, the only
// server-to-server (not user-click-driven) mutation path in this app.
// ---------------------------------------------------------------------------

enum SubscriptionPlanCategory {
  DAILY_POOJA
  WEEKLY_FLOWERS
  RAW_FLOWERS
  CUSTOM
}

enum BillingInterval {
  WEEKLY
  MONTHLY
  ANNUAL
}

/// Razorpay's own subscription statuses, used verbatim (not translated into
/// a house taxonomy) so the webhook handler's mapping from event payloads
/// stays a straight uppercase-and-store, and so admins looking at Razorpay's
/// own dashboard see the same vocabulary here.
enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  /// Customer-initiated (see "Pause"/"Resume" on /account/subscriptions) —
  /// distinct from HALTED, which is Razorpay giving up after repeated
  /// failed charge attempts. Razorpay's actual API supports this status
  /// (confirmed against their docs), even though the installed `razorpay`
  /// npm package's own TypeScript types omit it from the union — see
  /// razorpay.ts's pauseRazorpaySubscription/resumeRazorpaySubscription.
  PAUSED
  CANCELLED
  COMPLETED
  EXPIRED
}

/// The admin-managed catalog entry — the *product* (e.g. "Daily Pooja
/// Flowers"), not its pricing. Pricing lives on SubscriptionPlanInterval
/// child rows, since a plan can offer more than one billing cadence.
model SubscriptionPlan {
  id            String                     @id @default(cuid())
  name          String
  description   String                     @db.Text
  category      SubscriptionPlanCategory   @default(CUSTOM)
  imageUrl      String?
  isActive      Boolean                    @default(true)
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  intervals     SubscriptionPlanInterval[]
  subscriptions CustomerSubscription[]

  @@index([isActive, sortOrder])
}

/// One row per billable cadence a plan offers — maps 1:1 to a real Razorpay
/// Plan object (Razorpay's own Plans are interval-specific), created via
/// their API the first time an admin saves this interval with pricing.
model SubscriptionPlanInterval {
  id                 String                 @id @default(cuid())
  subscriptionPlanId String
  interval           BillingInterval
  /// ₹ per billing cycle at this interval.
  price              Int
  /// vs. the plan's weekly-equivalent baseline — display only ("Save 15%"),
  /// doesn't change what Razorpay actually charges (that's just `price`).
  discountPercent    Int                    @default(0)
  /// Created lazily — null until an admin actually saves this interval with
  /// pricing (see features/subscription/actions.ts).
  razorpayPlanId     String?
  createdAt          DateTime               @default(now())
  subscriptionPlan   SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  subscriptions      CustomerSubscription[]

  @@unique([subscriptionPlanId, interval])
}

/// A customer's actual subscription. `status` mirrors Razorpay's own
/// subscription lifecycle exactly — see the webhook handler. Delivery
/// address is snapshotted (not a live Address FK) — same reasoning as
/// Order's own delivery fields: a later address edit/deletion shouldn't
/// silently change where an active subscription ships.
model CustomerSubscription {
  id                         String                   @id @default(cuid())
  userId                     String
  subscriptionPlanId         String
  subscriptionPlanIntervalId String
  razorpaySubscriptionId     String                   @unique
  status                     SubscriptionStatus       @default(CREATED)
  recipientName              String
  recipientPhone             String
  deliveryLine1              String
  deliveryLine2              String?
  deliveryCity               String
  deliveryState              String
  deliveryPincode            String
  /// End of the current billing cycle — set/refreshed from the
  /// subscription.charged webhook payload's current_end.
  currentPeriodEnd           DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  user                       User                     @relation(fields: [userId], references: [id])
  plan                       SubscriptionPlan         @relation(fields: [subscriptionPlanId], references: [id])
  planInterval               SubscriptionPlanInterval @relation(fields: [subscriptionPlanIntervalId], references: [id])
  orders                     Order[]

  @@index([userId])
  @@index([status])
}

enum ReminderOccasion {
  BIRTHDAY
  ANNIVERSARY
  OTHER
}

/// Customer-saved dates ("My Reminders" on the account page) — a
/// low-effort, high-value nudge (per the competitive pass against FNP,
/// which has this) to order for birthdays/anniversaries they'd otherwise
/// forget. Recurs every year, so only month+day are meaningful — no year
/// stored. The actual "send the email N days before" trigger is an
/// external cron job hitting /api/cron/send-reminders (see that route's
/// own doc comment) — this table just holds what to check.
model Reminder {
  id            String           @id @default(cuid())
  userId        String
  occasion      ReminderOccasion
  recipientName String
  /// 1-12.
  month         Int
  /// 1-31 — never validated against the specific month's real length
  /// (Feb 30 would just never fire), a deliberate simplicity trade-off
  /// over pulling in date-range validation for a low-stakes reminder field.
  day           Int
  note          String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([month, day])
}

// Audit trail for order status changes — who changed what, when. changedBy*
// fields are a snapshot (name/role at the time), not a hard FK to User, so
// the log stays intact even if a staff account is later deleted — matches
// the same snapshot pattern OrderItem already uses for productTitle etc.
model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String
  changedByName   String
  changedByRole   String
  note            String?
  createdAt       DateTime     @default(now())
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  productTitle String
  variantLabel String?
  imageUrl     String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int
  /// Tax snapshot at order time — see Order's tax fields for why these
  /// aren't derived live from the product's current category.
  gstRate      Int             @default(0)
  hsnCode      String?
  taxableValue Int             @default(0)
  taxAmount    Int             @default(0)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  /// Not a hard FK (survives a deleted account, same "snapshot, not
  /// reference" pattern as OrderStatusHistory.changedByUserId) — but real
  /// customer submissions always set this, enforcing one review per user
  /// per product via the unique index below. Null only for legacy/seeded
  /// rows that predate the review-submission flow.
  userId     String?
  authorName String
  rating     Int
  comment    String   @db.Text
  /// Customer submissions (features/review/actions.ts's submitReviewAction)
  /// always create with this explicitly false, regardless of the default
  /// here — every real review enters the /admin/reviews moderation queue
  /// first. The `true` default only benefits admin-created/seeded rows.
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

/// Curated homepage marketing quotes ("What Customers Are Saying") —
/// distinct from Review above: this is admin-written/curated general
/// social proof, not a specific customer's rating of one product. Admin
/// managed at /admin/testimonials (testimonials:manage).
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  quote      String   @db.Text
  rating     Int      @default(5)
  photoUrl   String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([isActive, sortOrder])
}

/// Admin-managed FAQ content — powers both the homepage accordion and the
/// standalone /faq page (features/faq/queries.ts), replacing what used to
/// be two separately hardcoded arrays that had already drifted apart.
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  /// Optional grouping (e.g. "Ordering" | "Delivery" | "Payment") — the
  /// standalone /faq page groups by this; the homepage accordion ignores
  /// it and just shows every active item flat.
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Blog — care tips, occasion guides, etc. Publicly readable; no admin UI to
// author posts yet, so content is seeded (prisma/seed.ts) rather than
// user-submitted.
// ---------------------------------------------------------------------------

model BlogPost {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  title                  String
  excerpt                String   @db.Text
  content                String   @db.Text
  coverImageUrl          String?
  coverImageAlt          String?
  coverImageCloudinaryId String?
  authorName             String
  readTimeMinutes        Int      @default(4)
  isPublished            Boolean  @default(true)
  publishedAt            DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// ---------------------------------------------------------------------------
// Gift cards — paid for online (Razorpay only, no COD: there's nothing to
// hand over on delivery for a digital code). `balance` starts equal to
// `amount` and isn't decremented anywhere yet — no redemption-at-checkout
// flow in this pass, same "real field, no fake flow" approach as
// User.walletBalance.
// ---------------------------------------------------------------------------

enum GiftCardRecipientType {
  SELF
  OTHER
}

model GiftCard {
  id                String                @id @default(cuid())
  code              String                @unique
  amount            Int
  /// Unredeemed value still claimable — set to 0 once redeemedAt is set,
  /// since the value has fully moved into the redeemer's User.walletBalance
  /// at that point (redemption is all-or-nothing, not partial/spendable
  /// per-card at checkout — see gift-card.repository.ts's redeemGiftCard).
  balance           Int
  purchaserId       String
  recipientType     GiftCardRecipientType @default(SELF)
  recipientName     String?
  recipientEmail    String?
  recipientPhone    String?
  message           String?               @db.Text
  deliveryDate      DateTime?
  paymentStatus     PaymentStatus         @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  /// Null until claimed. A SELF-purchase or admin-issued card auto-redeems
  /// to its own purchaser the moment it's paid/issued (no separate claim
  /// step); an OTHER (gifted) card stays unredeemed until the recipient
  /// enters the code themselves — see redeemGiftCardAction.
  redeemedAt        DateTime?
  redeemedByUserId  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  purchaser         User                  @relation(fields: [purchaserId], references: [id])
  redeemedBy        User?                 @relation("GiftCardRedemptions", fields: [redeemedByUserId], references: [id])
  adjustments       GiftCardAdjustment[]

  @@index([purchaserId])
  @@index([redeemedByUserId])
}

/// Audit trail for manual balance changes (Super Admin only — real money).
/// Every manual issue/adjustment writes one of these alongside mutating
/// GiftCard.balance, so "who changed this and why" is always answerable.
model GiftCardAdjustment {
  id               String   @id @default(cuid())
  giftCardId       String
  /// Signed — positive credits the balance, negative debits it.
  amount           Int
  reason           String
  adjustedByUserId String
  createdAt        DateTime @default(now())
  giftCard         GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  adjustedBy       User     @relation(fields: [adjustedByUserId], references: [id])

  @@index([giftCardId])
}

/// Single-row site configuration (id is always the fixed string below —
/// there's only ever one row). Seeded with today's hardcoded defaults on
/// first read via an upsert (see store-settings.repository.ts), so there's
/// no manual seed step and no migration-ordering hazard. settings:manage
/// (super_admin/admin) can edit; settings:view (store_manager too) is
/// read-only — see permissions.ts.
model StoreSettings {
  id                    String @id @default("singleton")
  /// ₹, flat — added to every order unless the subtotal clears freeDeliveryThreshold.
  baseDeliveryCharge    Int    @default(49)
  freeDeliveryThreshold Int    @default(999)
  /// IST 24h hour after which same-day Midnight-slot booking closes and
  /// Express/Instant starts carrying Midnight pricing instead. The actual ₹
  /// surcharges for Express/Midnight live on their own DeliverySlot rows
  /// (single source of truth for both what's charged and what's advertised
  /// on the marketing pages) — deliberately NOT duplicated here anymore.
  /// See lib/delivery.ts's effectiveSlotCharge and
  /// delivery-slot.repository.ts's findActiveDeliverySlotByType.
  midnightCutoffHour    Int    @default(20)

  // --- Delivery serviceability — checked at checkout (see lib/geo.ts's
  // haversineDistanceKm) against each address's Google-geocoded lat/lng.
  // Both store coordinates are null until an admin sets them from
  // /admin/settings (via the same Google Places picker used for customer
  // addresses); the check is skipped entirely while either is null rather
  // than blocking every order, matching the GST-block-omitted-until-set
  // convention already used below for gstin. ---
  storeLatitude    Float?
  storeLongitude   Float?
  /// km, straight-line (haversine) — not driving distance. 10 is a
  /// reasonable starting radius for a single-city florist; admin-editable.
  deliveryRadiusKm Int    @default(10)

  // --- Tax (GST) — used for invoice generation and reporting. Prices
  // throughout the storefront are tax-INCLUSIVE (standard for Indian D2C
  // retail — the price shown is the price paid); these fields let invoices
  // and reports back-calculate the CGST/SGST/IGST breakup without changing
  // any checkout total. ---
  /// This business's GSTIN. Null until set — invoices omit the GST block
  /// entirely (and stay non-tax-invoices) rather than show a blank GSTIN.
  gstin                 String?
  legalBusinessName     String?
  registeredAddressLine String?
  registeredCity        String?
  /// The state GST registration is under — compared against each order's
  /// delivery state to decide CGST+SGST (same state) vs IGST (different state).
  registeredState       String  @default("Gujarat")
  registeredPincode     String?
  /// Fallback GST% for a product whose category has no rate configured —
  /// never silently taxed at 0% just because a category was missed.
  defaultGstRate        Int     @default(0)
  /// e.g. "SF" — invoice numbers are formatted "{prefix}/{FY}/{sequence}",
  /// FY being the Indian financial year (Apr–Mar) the order was confirmed in.
  invoicePrefix         String  @default("SF")
  /// Last sequence number issued, per financial year — see
  /// order.repository.ts's invoice-numbering transaction. Reset to 0 at the
  /// start of each new FY (tracked via lastInvoiceFY below) since GST invoice
  /// series conventionally restart each year.
  lastInvoiceNumber     Int     @default(0)
  /// e.g. "2526" for FY 2025-26 — the FY lastInvoiceNumber was last issued
  /// in, so the counter can detect a new year and reset.
  lastInvoiceFY         String?

  // --- Payment gateways — which methods are offered at checkout. Actual
  // credentials stay in .env (never admin-editable text fields); this only
  // toggles availability. ---
  codEnabled      Boolean @default(true)
  razorpayEnabled Boolean @default(true)

  // --- Refer-a-friend — ₹ credited to BOTH the referrer's and the new
  // customer's wallet the moment the new customer's first order is
  // confirmed/paid (see order.service.ts's placeOrder). 0 effectively
  // turns the program off without touching any code. ---
  referralBonusAmount Int @default(100)

  updatedAt DateTime @updatedAt
}

/// General-purpose audit trail — every admin mutation that changes
/// something meaningful (price, stock, catalog structure, settings...)
/// writes one of these. Order status changes and gift card balance changes
/// already have their own purpose-built history tables (OrderStatusHistory,
/// GiftCardAdjustment) and aren't duplicated here. Powers both a dedicated
/// /admin/audit-log page and the dashboard's Activity Feed (just the most
/// recent rows).
model AuditLog {
  id              String   @id @default(cuid())
  /// "Product" | "Category" | "Coupon" | "DeliverySlot" | "BlogPost" | "StoreSettings" | "Banner" | "Holiday" | "Customer" | "CartSnapshot" | "EmailCampaign" | "GalleryItem" | "Testimonial" | "FaqItem" | "SubscriptionPlan"
  entityType      String
  entityId        String
  entityLabel     String
  /// "created" | "updated" | "archived" | "restored" | "deleted"
  action          String
  /// Human-readable summary shown in the Activity Feed, e.g. "Changed price from ₹499 to ₹549".
  summary         String
  changedByUserId String
  changedByName   String
  changedByRole   String
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Dates delivery is unavailable — checked alongside the existing
/// cutoff-hour logic in lib/delivery.ts. A festival/holiday closure, not a
/// per-slot-type rule (blocksAllDelivery: false means only Midnight is
/// blocked — the common case of "closed at night, open in the day").
model Holiday {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  label             String
  blocksAllDelivery Boolean  @default(true)

  @@unique([date])
}

enum BannerType {
  HERO
  PROMO
  OCCASION
}

/// Replaces the hardcoded homepage-content fixtures — HERO (hero slider),
/// PROMO (promo strip), OCCASION (occasion banner). Read fresh on every
/// page render, so a startsAt/endsAt window is "automatic" activation with
/// no cron job needed — the query itself only returns what's live right now.
model Banner {
  id                String     @id @default(cuid())
  type              BannerType
  eyebrow           String?
  headline          String
  subtitle          String?
  ctaLabel          String?
  ctaHref           String?
  imageUrl          String?
  imageAlt          String?
  imageCloudinaryId String?
  isActive          Boolean    @default(true)
  /// Null = no scheduled window — active whenever isActive is true.
  startsAt          DateTime?
  endsAt            DateTime?
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

/// Server-side mirror of a signed-in user's cart, synced from the client
/// cart store — lets the admin see and recover abandoned carts. One row per
/// user; cleared (not deleted) on checkout. Guest/anonymous carts aren't
/// tracked — there's no durable identity to recover them against.
model CartSnapshot {
  id             String    @id @default(cuid())
  userId         String    @unique
  items          Json
  itemCount      Int       @default(0)
  subtotal       Int       @default(0)
  updatedAt      DateTime  @updatedAt
  /// Set when a recovery email is sent, so the same abandoned cart isn't re-emailed repeatedly.
  reminderSentAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Manual marketing tags an admin assigns to a customer (e.g. "Wedding
/// season lead") — separate from the computed segments (VIP/Frequent/
/// Inactive), which are derived live from order history, not stored.
model CustomerTag {
  id        String   @id @default(cuid())
  userId    String
  label     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
}

/// Every Cloudinary upload made through the admin panel is recorded here
/// (see cloudinary-uploader.tsx's onSuccess), so it can be browsed and
/// reused across products/categories/blog/banners via the media library
/// picker instead of every field needing a fresh upload.
model MediaAsset {
  id               String   @id @default(cuid())
  url              String
  cloudinaryId     String
  alt              String?
  /// "products" | "categories" | "blog" | "banners" — matches CloudinaryUploader's folder prop.
  folder           String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  @@index([folder])
}

/// Real (double opt-in) newsletter subscription — replaces the footer
/// form's previous fake `setTimeout` stub. `isConfirmed` only flips true
/// once the subscriber clicks the link in their confirmation email; an
/// unconfirmed row is never emailed by the marketing sender (EmailCampaign
/// below), only ever sent the one confirmation email itself.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  isConfirmed      Boolean   @default(false)
  confirmToken     String    @unique
  unsubscribeToken String    @unique
  subscribedAt     DateTime  @default(now())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
}

/// Audit log of admin-sent marketing/bulk emails — not a send queue (the
/// send itself is a synchronous throttled loop in the action, see
/// features/marketing-email/actions.ts). One row per campaign, not per
/// recipient — recipientCount is a snapshot for display, not a join table.
model EmailCampaign {
  id              String   @id @default(cuid())
  subject         String
  body            String   @db.Text
  /// "newsletter" | "segment:vip" | "segment:frequent" | "segment:inactive" | "segment:new" | "segment:regular"
  audience        String
  recipientCount  Int
  createdByUserId String
  createdByName   String
  createdAt       DateTime @default(now())
}

/// Every /contact page submission — previously email-only (sendContactMessageAction
/// just fired an email to the store inbox with no DB record and no admin
/// visibility at all). Storing it now means a lost/filtered email doesn't
/// mean a lost inquiry.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

/// Real customer-facing showcase (photos + short videos of actual work),
/// admin-uploaded via Cloudinary — distinct from the earlier (unused)
/// MediaAsset model, which was for internal image reuse across content,
/// not a public-facing display feed with its own ordering/caption/type.
model GalleryItem {
  id           String          @id @default(cuid())
  type         GalleryItemType @default(IMAGE)
  url          String
  cloudinaryId String
  /// Cloudinary auto-generates a poster frame for uploaded videos — stored
  /// so the grid can show a still image instead of loading the full video
  /// just to render a thumbnail.
  thumbnailUrl String?
  caption      String?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  @@index([isActive, sortOrder])
}
